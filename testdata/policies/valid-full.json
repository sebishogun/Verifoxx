{
  "schema_version": 1,
  "name": "verifoxx",
  "version": "1.0.0",
  "assumptions": [
    "Policy {policy_name} version {policy_version} applies to request {request_id}."
  ],
  "evidence_kinds": [
    {"name": "approval_record"},
    {"name": "usage_adjustment"}
  ],
  "evidence_states": [
    {"name": "current"},
    {"name": "missing"},
    {"name": "stale"},
    {"name": "unclear"},
    {"name": "unverifiable"},
    {"name": "conflict"}
  ],
  "outcomes": [
    {"name": "Approve", "precedence": 1, "terminal": true},
    {"name": "Reject", "precedence": 4, "terminal": true},
    {"name": "Revise", "precedence": 2, "terminal": false},
    {"name": "Escalate", "precedence": 3, "terminal": true}
  ],
  "requirements": [
    {
      "id": "R1",
      "source": "External requests require approval.",
      "applies": {"op": "equal", "field": "subject.trust", "value": "external"},
      "clauses": [
        {
          "assert": {
            "op": "all",
            "args": [
              {"op": "exists", "field": "context.environment"},
              {"op": "in", "field": "context.usage", "values": ["standard", "limited"]}
            ]
          },
          "evidence": [
            {
              "op": "evidence_matches",
              "kind": "approval_record",
              "state": "current",
              "explanation": {
                "issue": "Required {evidence_kind} evidence is {reason}.",
                "conflict": "Evidence {evidence_id} has conflicting state {evidence_state}."
              }
            }
          ],
          "resolution": {
            "satisfied": {
              "outcome": "Approve",
              "explanation": {"rationale": "Requirement {requirement_id} is satisfied.", "uncertainty": []}
            },
            "false": {
              "outcome": "Reject",
              "explanation": {"rationale": "Requirement {requirement_id} is violated.", "uncertainty": []}
            },
            "missing": {
              "outcome": "Escalate",
              "explanation": {"rationale": "Required evidence is {reason}.", "uncertainty": ["Qualifying evidence remains unresolved."]}
            },
            "stale": {
              "outcome": "Escalate",
              "explanation": {"rationale": "Required evidence is {reason}.", "uncertainty": []}
            },
            "unclear": {
              "outcome": "Escalate",
              "explanation": {"rationale": "Required evidence is {reason}.", "uncertainty": []}
            },
            "unverifiable": {
              "outcome": "Escalate",
              "explanation": {"rationale": "Required evidence is {reason}.", "uncertainty": []}
            },
            "conflict": {
              "outcome": "Escalate",
              "explanation": {"rationale": "Required evidence is {reason}.", "uncertainty": []}
            }
          },
          "remediations": [
            {"kind": "set_field", "field": "context.usage", "value": "standard"},
            {"kind": "add_evidence", "evidence_kind": "usage_adjustment"}
          ]
        }
      ]
    }
  ]
}
